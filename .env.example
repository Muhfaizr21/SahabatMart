# Database
DB_HOST=localhost
DB_USER=akuglow
DB_PASSWORD=akuglow_secret
DB_NAME=akuglow
DB_PORT=5432

# Server
PORT=8080
APP_ENV=development
JWT_SECRET=your-512-bit-hex-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# TriPay (Payment Gateway)
TRIPAY_MERCHANT_CODE=your-merchant-code
TRIPAY_API_KEY=your-api-key
TRIPAY_PRIVATE_KEY=your-private-key
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Biteship (Shipping)
BITESHIP_API_KEY=your-biteship-api-key
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_CALLBACK_URL=http://localhost:8080/api/shipping/webhook

# Sentry (Error Monitoring)
SENTRY_DSN=

# App URL
APP_URL=http://localhost:8080
